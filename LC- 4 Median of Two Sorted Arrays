class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int i = 0; 
        int j = 0;
        int k = 0;
        int m = nums1.length;
        int n = nums2.length;
        int result[] = new int[m + n];
        while(i < m && j < n){
            if(nums1[i] < nums2[j]){
                result[k] = nums1[i];
                i++;
                k++;

            }else{
                result[k] = nums2[j];
                j++;
                k++;
            }
        }
        while(i < m){
            result[k] = nums1[i];
            i++;
            k++;
        }
            while(j < n){
        result[k] = nums2[j];
            j++;
            k++;
    }

    if(result.length % 2 != 0){
        return result[result.length / 2];
    }else{
        return ((double) result[result.length / 2] + result[(result.length / 2) - 1]) /2;
    }
    

    }
}
