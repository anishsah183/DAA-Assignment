class Solution {
    public int findKthLargest(int[] nums, int k) {
        if(nums.length == 0){
            return -1;
        }

        PriorityQueue<Integer> pq = new PriorityQueue<>();

        for(int ele : nums){
            pq.offer(ele);
            if(pq.size() > k){
                pq.poll();
            }
        }

        return pq.peek();
    }
}
